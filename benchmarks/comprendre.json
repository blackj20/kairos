{
  "description": "Corpus de validation de la fondation Comprendre. Les variantes servent de test de généralisation structurelle, pas de preuve de compréhension générale.",
  "cases": [
    {
      "group": "core",
      "text": "install python",
      "expected": {"type": "ordre", "action": "installer", "cible": "python", "route": "competence"}
    },
    {
      "group": "core",
      "text": "salut cv?",
      "expected": {"type": "question", "route": "repondre"}
    },
    {
      "group": "core",
      "text": "n'installe pas python",
      "expected": {"type": "interdiction", "action": "installer", "cible": "python", "route": "controle"}
    },
    {
      "group": "core",
      "text": "c'est quoi un atome",
      "expected": {"type": "lecon", "route": "repondre"}
    },
    {
      "group": "core",
      "text": "tu t'es trompé",
      "expected": {"type": "retour_utilisateur", "route": "repondre"}
    },
    {
      "group": "core",
      "text": "bonjour",
      "expected": {"type": "demarrage_conversation", "route": "repondre"}
    },
    {
      "group": "core",
      "text": "je marche vers la maison",
      "expected": {"type": "affirmation", "action": "marcher", "cible": "maison", "route": "repondre"}
    },
    {
      "group": "core",
      "text": "la marche de cet escalier",
      "expected": {"type": "inconnu", "route": "clarification"}
    },

